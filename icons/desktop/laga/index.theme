[Icon Theme]
Name=LaGaDesk-BlackWhite-III
Comment=mixed by LaGaDesk. All the credits to the authors of the used icon themes: black-white_2_Neon, mac4lin, hydroxygen, blended crystal, breathless, dark glass and all the others..
Directories=scalable/animations,scalable/apps/22,scalable/spinner,scalable/stock/net/24,scalable/actions,scalable/apps/32,scalable/emblems/32,scalable/status/32,scalable/actions/48,scalable/apps/48,scalable/emblems/48,scalable/status/48,scalable/apps/64,scalable/categories,scalable/emblems,scalable/status,72x72/apps,scalable/apps,scalable/places,scalable/mimetypes,scalable/devices,scalable/status/128,scalable/places/256,scalable/devices/256

# The drawings are PNG. Type is matched with its case: a lowercase "scalable" is not Scalable but the
# default, Threshold, which GTK 3 never scales. GTK 3 scales a Scalable directory only between MinSize
# and MaxSize, which default to Size: every one may be drawn from 8 px up to its own size, never larger

[scalable/animations]
Size=22
Context=Animations
Type=Fixed

[scalable/apps/22]
Size=22
Context=Applications
Type=Scalable
MinSize=8
MaxSize=22

